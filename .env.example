DISCORD_BOT_TOKEN=your_discord_bot_token
API_URL=http://localhost:8000

# Local voice activation
VOICE_WAKE_PHRASE=hey bart
VOICE_SILENCE_MS=500
VOICE_LOG_TRANSCRIPTS=true
WHISPER_LANGUAGE=en
WHISPER_SERVER_URL=http://127.0.0.1:8080/inference
WHISPER_USE_GPU=true
WHISPER_START_SERVER=true

# These default to whisper_runtime paths created by npm run setup:whisper
WHISPER_EXECUTABLE_PATH=
WHISPER_MODEL_PATH=
WHISPER_THREADS=4

# Optional: join these channels automatically when the bot starts
VOICE_AUTOJOIN_CHANNEL_ID=
VOICE_COMMAND_TEXT_CHANNEL_ID=
